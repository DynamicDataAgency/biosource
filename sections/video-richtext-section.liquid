<section class="video-text-section">
  <div class="container">
    <div class="video-text-stack">
      <!-- Video Embed -->
      <div class="video-column">
        {% if section.settings.embed_code != blank %}
          <div class="code-wrapper">
            {{ section.settings.embed_code }}
          </div>
        {% else %}
          <p>Please provide embed code in the section settings.</p>
        {% endif %}
      </div>
      <!-- Text Content -->
      <div class="text-column">
        <div class="formatted-text">
          {{ section.settings.text_content }}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .video-text-section .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }

  .video-text-stack {
    display: flex;
    flex-direction: column; /* Stacks video and text vertically */
    gap: 20px;
  }

  .video-column {
    width: 100%;
  }

  .code-wrapper {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9; /* Maintains 16:9 aspect ratio */
  }

  .code-wrapper iframe, 
  .code-wrapper embed,
  .code-wrapper object {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .text-column .formatted-text {
    font-size: 16px;
    line-height: 1.6;
  }

  /* Optional: Center-align content for aesthetic purposes */
  .video-text-section .formatted-text {
    text-align: left; /* Change to center if preferred */
  }
</style>

{% schema %}
{
  "name": "Video and Text Stack",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "default": "<iframe src='https://www.youtube.com/embed/example' frameborder='0' allowfullscreen></iframe>"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Text Content",
      "default": "<h2>Your Title Here</h2><p>Write your content here. Use <strong>bold</strong>, <em>italic</em>, or other rich formatting options.</p>"
    }
  ],
  "presets": [
    {
      "name": "Video and Text Stack",
      "category": "Custom"
    }
  ]
}
{% endschema %}
