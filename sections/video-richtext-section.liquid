<section class="video-text-section">
  <div class="container">
    <div class="video-text-wrapper">
      <!-- Left Column: Video Embed -->
      <div class="video-column">
        {% if section.settings.embed_code != blank %}
          <div class="code-wrapper">
            {{ section.settings.embed_code }}
          </div>
        {% else %}
          <p>Please provide embed code in the section settings.</p>
        {% endif %}
      </div>
      <!-- Right Column: Text Content -->
      <div class="text-column">
        <div class="formatted-text">
          {{ section.settings.text_content }}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .video-text-section .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .video-text-wrapper {
    display: block; /* Ensures natural flow */
  }

  .video-column {
    float: left; /* Video floats to the left */
    width: 50%; /* Takes half the width */
    margin-right: 20px; /* Adds spacing between video and text */
    box-sizing: border-box;
  }

  .code-wrapper {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* Aspect ratio 16:9 */
  }

  .code-wrapper iframe, 
  .code-wrapper embed, 
  .code-wrapper object {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .text-column {
    overflow: hidden; /* Clears float */
  }

  .formatted-text {
    font-size: 16px;
    line-height: 1.6;
  }

  /* Responsive behavior for smaller screens */
  @media (max-width: 768px) {
    .video-column {
      float: none;
      width: 100%; /* Full width for video */
      margin-right: 0; /* No spacing needed */
    }

    .text-column {
      overflow: visible;
      width: 100%; /* Full width for text */
    }
  }
</style>

{% schema %}
{
  "name": "Video and Wrapping Text",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "default": "<iframe src='https://www.youtube.com/embed/example' frameborder='0' allowfullscreen></iframe>"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Formatted Text Content",
      "default": "<h2>Your Title Here</h2><p>Write your content here. Use <strong>bold</strong>, <em>italic</em>, or other rich formatting options.</p>"
    }
  ],
  "presets": [
    {
      "name": "Video and Wrapping Text",
      "category": "Custom"
    }
  ]
}
{% endschema %}
