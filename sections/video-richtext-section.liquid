<section class="video-text-section">
  <div class="container">
    <div class="video-text-grid">
      <!-- Left Column: Video Embed -->
      <div class="video-column">
        {% if section.settings.embed_code != blank %}
          <div class="code-wrapper">
            {{ section.settings.embed_code }}
          </div>
        {% else %}
          <p>Please provide embed code in the section settings.</p>
        {% endif %}
      </div>
      <!-- Right Column: Text Content -->
      <div class="text-column">
        <div class="formatted-text">
          {{ section.settings.text_content }}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .video-text-section .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .video-text-grid {
    display: grid;
    grid-template-columns: 1fr; /* Single-column layout by default */
    gap: 20px;
  }

  .video-column {
    grid-column: 1; /* Video will always appear first */
  }

  .text-column {
    grid-column: 1; /* Text will wrap under video in single-column mode */
  }

  .code-wrapper {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9; /* Maintains 16:9 aspect ratio */
  }

  .code-wrapper iframe, 
  .code-wrapper embed,
  .code-wrapper object {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .formatted-text {
    font-size: 16px;
    line-height: 1.6;
  }

  /* Two-column layout for larger screens */
  @media (min-width: 768px) {
    .video-text-grid {
      grid-template-columns: 1fr 1fr; /* Two equal columns */
      gap: 20px;
    }

    .video-column {
      grid-column: 1; /* Video in left column */
    }

    .text-column {
      grid-column: 2; /* Text in right column */
    }
  }
</style>

{% schema %}
{
  "name": "Video and Text Section",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "default": "<iframe src='https://www.youtube.com/embed/example' frameborder='0' allowfullscreen></iframe>"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Formatted Text Content",
      "default": "<h2>Your Title Here</h2><p>Write your content here. Use <strong>bold</strong>, <em>italic</em>, or other rich formatting options.</p>"
    }
  ],
  "presets": [
    {
      "name": "Video and Text Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}

