<section class="video-text-section">
  <div class="container">
    <div class="video-text-flex">
      <!-- Left Column: Video Embed -->
      <div class="video-column">
        {% if section.settings.embed_code != blank %}
          <div class="code-wrapper">
            {{ section.settings.embed_code }}
          </div>
        {% else %}
          <p>Please provide embed code in the section settings.</p>
        {% endif %}
      </div>
      <!-- Right Column: Text Content -->
      <div class="text-column">
        <div class="formatted-text">
          {{ section.settings.text_content }}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .video-text-section .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .video-text-flex {
    display: flex;
    flex-wrap: wrap; /* Allows wrapping when necessary */
    gap: 20px;
  }

  .video-column {
    flex: 1 1 300px; /* Minimum width of 300px */
    max-width: 50%; /* Ensures it doesn't exceed half the container width */
  }

  .code-wrapper {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9; /* Maintains 16:9 aspect ratio */
  }

  .code-wrapper iframe, 
  .code-wrapper embed,
  .code-wrapper object {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .text-column {
    flex: 1 1 300px; /* Minimum width of 300px */
    max-width: 50%; /* Ensures it doesn't exceed half the container width */
  }

  .formatted-text {
    font-size: 16px;
    line-height: 1.6;
  }

  /* Adjustments for when the text wraps under the video */
  @media (max-width: 768px) {
    .video-column, .text-column {
      flex: 1 1 100%; /* Full width for both columns */
    }

    .video-text-flex {
      flex-direction: column; /* Stack columns vertically */
    }
  }
</style>

{% schema %}
{
  "name": "Responsive Video and Text",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "default": "<iframe src='https://www.youtube.com/embed/example' frameborder='0' allowfullscreen></iframe>"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "Formatted Text Content",
      "default": "<h2>Your Title Here</h2><p>Write your content here. Use <strong>bold</strong>, <em>italic</em>, or other rich formatting options.</p>"
    }
  ],
  "presets": [
    {
      "name": "Responsive Video and Text",
      "category": "Custom"
    }
  ]
}
{% endschema %}
