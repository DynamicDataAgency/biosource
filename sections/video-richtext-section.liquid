<section class="video-text-section">
  <div class="container">
    <div class="video-text-grid">
      <!-- Left Column: Video Embed -->
      <div class="video-column">
        {% if section.settings.embed_code != blank %}
          <div class="code-wrapper">
            {{ section.settings.embed_code }}
          </div>
        {% else %}
          <p>Please provide embed code in the section settings.</p>
        {% endif %}
      </div>
      <!-- Right Column: Custom HTML Content -->
      <div class="custom-html-column">
        <div class="custom-html-content">
          {{ section.settings.custom_html }}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .video-text-section .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .video-text-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Two columns side by side */
    gap: 20px;
  }

  .video-column {
    grid-column: 1; /* Video on the left */
  }

  .custom-html-column {
    grid-column: 2; /* Custom HTML on the right */
  }

  .code-wrapper {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9; /* Maintains 16:9 aspect ratio */
  }

  .code-wrapper iframe, 
  .code-wrapper embed, 
  .code-wrapper object {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .custom-html-content {
    font-size: 16px;
    line-height: 1.6;
  }

  /* Responsive behavior for smaller screens */
  @media (max-width: 768px) {
    .video-text-grid {
      grid-template-columns: 1fr; /* Single-column layout for mobile */
    }

    .video-column, .custom-html-column {
      grid-column: 1; /* Both video and custom HTML in one column */
    }
  }
</style>

{% schema %}
{
  "name": "Video & HTML Section",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "default": "<iframe src='https://www.youtube.com/embed/example' frameborder='0' allowfullscreen></iframe>"
    },
    {
      "type": "textarea",
      "id": "custom_html",
      "label": "Custom HTML Content",
      "default": "<p>Enter your custom HTML here, including <strong>tags</strong>, <a href='#'>links</a>, etc.</p>"
    }
  ],
  "presets": [
    {
      "name": "Video & HTML Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
