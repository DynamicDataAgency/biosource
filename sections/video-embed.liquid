<section class="video-section">
  <div class="container">
    <div class="video-wrapper">
      {% if section.settings.embed_code != blank %}
        <div class="code-wrapper">
          {{ section.settings.embed_code }}
        </div>
      {% else %}
        <p>Please provide embed code in the section settings.</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .video-section .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0; /* Remove extra padding */
    overflow: hidden; /* Ensure no extra space */
  }

  .video-wrapper {
    width: 100%;
    position: relative;
    height: 0; /* Set height to 0 to avoid extra space */
    padding-top: 56.25%; /* Maintain 16:9 aspect ratio */
    margin: 0; /* Remove margin to prevent space */
  }

  .code-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Ensure iframe content fills the parent div */
  .code-wrapper iframe {
    width: 100%;
    height: 100%;
  }

  /* Responsive behavior for smaller screens */
  @media (max-width: 768px) {
    .video-wrapper {
      padding-top: 56.25%; /* Keeps 16:9 aspect ratio */
    }
  }
</style>

{% schema %}
{
  "name": "One-Column Video Embed",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "default": "<iframe src='https://www.youtube.com/embed/example' frameborder='0' allowfullscreen></iframe>"
    }
  ],
  "presets": [
    {
      "name": "One-Column Video Embed",
      "category": "Custom"
    }
  ]
}
{% endschema %}
