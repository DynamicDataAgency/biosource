<section class="video-embed-section">
  <div class="container">
    <!-- Video Embed Section -->
    <div class="video-column">
      {% if section.settings.embed_code != blank %}
        <div class="code-wrapper">
          {{ section.settings.embed_code }}
        </div>
      {% else %}
        <p>Please provide embed code in the section settings.</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .video-embed-section .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
  }

  .video-column {
    width: 100%;
    text-align: center; /* Centers the video */
  }

  .code-wrapper {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* Aspect ratio 16:9 */
  }

  .code-wrapper iframe, 
  .code-wrapper embed, 
  .code-wrapper object {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Responsive behavior for smaller screens */
  @media (max-width: 768px) {
    .video-column {
      width: 100%; /* Ensure full width on mobile */
    }
  }
</style>

{% schema %}
{
  "name": "Video Embed Section",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "default": "<iframe src='https://www.youtube.com/embed/example' frameborder='0' allowfullscreen></iframe>"
    }
  ],
  "presets": [
    {
      "name": "Video Embed Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
