{% schema %}
{
  "name": "Video Embed",
  "settings": [
    {
      "type": "text",
      "label": "Video Embed Code",
      "id": "video_embed_code",
      "default": "<iframe width=\"560\" height=\"315\" src=\"https://www.youtube.com/embed/dQw4w9WgXcQ\" frameborder=\"0\" allowfullscreen></iframe>",
      "info": "Paste your video embed code (e.g., from YouTube or Vimeo) here."
    }
  ],
  "presets": [
    {
      "name": "Default",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="video-embed-section">
  <div class="video-embed-container">
    <!-- Ensure the video embed code is rendered as HTML -->
    <div class="video-embed-content">
      {{ settings.video_embed_code | raw }}
    </div>
  </div>
</div>

<style>
  .video-embed-section {
    padding: 30px 0;
    background-color: #f4f4f4; /* Optional background color */
  }
  
  .video-embed-container {
    text-align: center;
    margin-bottom: 30px; /* Adds space for the next section */
  }

  .video-embed-content iframe {
    width: 100%;
    max-width: 800px;
    height: 450px; /* Default height */
    border: none;
  }

  /* For responsive design */
  @media screen and (max-width: 768px) {
    .video-embed-content iframe {
      max-width: 100%;
      height: 300px; /* Adjust the height for smaller screens */
    }
  }
</style>
