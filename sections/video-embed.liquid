{% if section.settings.embed_code %}
  <div class="video-embed-wrapper">
    <div class="video-embed">
      {{ section.settings.embed_code }}
    </div>
  </div>
{% endif %}

<style>
  .video-embed-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 aspect ratio */ 
    height: 0;
  }

  .video-embed {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 767px) {
    .video-embed-wrapper {
      padding-bottom: 177.78%; /* 9:16 aspect ratio for mobile */ 
    }
  }
</style>