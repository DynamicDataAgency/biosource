<section class="video-section">
  <div class="video-wrapper">
    {% if section.settings.video_embed_code != blank %}
      <div class="embed-container">
        {{ section.settings.video_embed_code | raw }}
      </div>
    {% else %}
      <p>Please provide a video embed code in the section settings.</p>
    {% endif %}
  </div>
</section>

<style>
  /* Reset margin and padding for the section */
  .video-section {
    margin: 0;
    padding: 0;
  }

  /* Wrapper ensures video embed maintains aspect ratio */
  .video-wrapper {
    width: 100%;
    position: relative;
    padding: 0;
    margin: 0;
  }

  /* Embed container handles responsive video scaling */
  .embed-container {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 Aspect Ratio */
  }

  .embed-container iframe,
  .embed-container embed,
  .embed-container object {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Mobile adjustments */
  @media (max-width: 768px) {
    .embed-container {
      padding-top: 56.25%; /* Maintain aspect ratio */
    }
  }
</style>

{% schema %}
{
  "name": "Video Embed Section",
  "settings": [
    {
      "type": "textarea",
      "id": "video_embed_code",
      "label": "Embed Code",
      "default": "<iframe src='https://www.youtube.com/embed/example' frameborder='0' allowfullscreen></iframe>"
    }
  ],
  "presets": [
    {
      "name": "Video Embed",
      "category": "Custom"
    }
  ]
}
{% endschema %}
